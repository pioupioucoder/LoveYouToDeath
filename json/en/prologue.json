[
  { "id": "prologue_1", "bg": "images/backgrounds/void.webp", "charImg": null, "speaker": null, "text": "My thoughts crash against one another. I try to move. My body won't respond.", "typeSpeed": 22, "music": "music/dark.mp3", "next": "prologue_2" },
  { "id": "prologue_2", "bg": "images/backgrounds/void.webp", "charImg": null, "speaker": "???", "text": "Useless. The drug is still in your veins.", "typeSpeed": 22, "music": "music/dark.mp3", "next": "prologue_3" },
  { "id": "prologue_3", "bg": "images/backgrounds/void.webp", "charImg": null, "speaker": null, "text": "I look up. A familiar face leans over me.", "typeSpeed": 22, "music": "music/dark.mp3", "next": "prologue_4" },
  { "id": "prologue_4", "bg": "images/backgrounds/void.webp", "charImg": null, "speaker": null, "text": "It is at once cold as ice and warm as fire, with a sinister smile.", "typeSpeed": 22, "music": "music/dark.mp3", "next": "prologue_5" },
  { "id": "prologue_5", "bg": "images/backgrounds/void.webp", "charImg": null, "speaker": null, "text": "No. That's not a smile.", "typeSpeed": 22, "music": "music/dark.mp3", "next": "prologue_6" },
  { "id": "prologue_6", "bg": "images/backgrounds/void.webp", "charImg": null, "speaker": null, "text": "It's madness.", "glitch": true, "typeSpeed": 22, "music": "music/dark.mp3", "next": "prologue_7" },
  { "id": "prologue_7", "bg": "images/backgrounds/void.webp", "charImg": null, "speaker": "Me", "text": "Why? Why did you kill them?", "typeSpeed": 22, "music": "music/dark.mp3", "next": "prologue_8" },
  { "id": "prologue_8", "bg": "images/backgrounds/void.webp", "charImg": null, "speaker": "???", "text": "Because I had to.", "typeSpeed": 22, "music": "music/dark.mp3", "next": "prologue_9" },
  { "id": "prologue_9", "bg": "images/backgrounds/void.webp", "charImg": null, "speaker": "???", "text": "I wanted you to need only me.", "typeSpeed": 22, "music": "music/dark.mp3", "next": "prologue_10" },
  { "id": "prologue_10", "bg": "images/backgrounds/void.webp", "charImg": null, "speaker": "Me", "text": "I don't recognize you anymore. Untie me.", "typeSpeed": 22, "music": "music/dark.mp3", "next": "prologue_11" },
  { "id": "prologue_11", "bg": "images/backgrounds/void.webp", "charImg": null, "speaker": "???", "text": "I will. After I eat your legs.", "typeSpeed": 22, "music": "music/dark.mp3", "next": "prologue_12" },
  { "id": "prologue_12", "bg": "images/backgrounds/void.webp", "charImg": null, "speaker": null, "text": "Her voice doesn't tremble. Mine does.", "typeSpeed": 22, "music": "music/dark.mp3", "next": "prologue_13" },
  { "id": "prologue_13", "bg": "images/backgrounds/void.webp", "charImg": null, "speaker": "???", "text": "Those legs that always try to run away from me.", "typeSpeed": 22, "music": "music/dark.mp3", "next": "prologue_14" },
  { "id": "prologue_14", "bg": "images/backgrounds/void.webp", "charImg": null, "speaker": null, "text": "Panic rises in my throat. I have to find a way out. I have to…", "typeSpeed": 22, "music": "music/dark.mp3", "next": "prologue_15" },
  { "id": "prologue_15", "bg": "images/backgrounds/void.webp", "charImg": null, "speaker": null, "text": "She leans closer. Her breath brushes my cheek. She smells of night, of metal, of blood…", "typeSpeed": 22, "music": "music/dark.mp3", "next": "prologue_16" },
  { "id": "prologue_16", "bg": "images/backgrounds/void.webp", "charImg": null, "speaker": "???", "text": "We're far from everything. Isolated. Just you and me.", "typeSpeed": 22, "music": "music/dark.mp3", "next": "prologue_17" },
  { "id": "prologue_17", "bg": "images/backgrounds/void.webp", "charImg": null, "speaker": "???", "text": "Is it time…", "typeSpeed": 22, "music": "music/dark.mp3", "next": "prologue_18" },
  { "id": "prologue_18", "bg": "images/backgrounds/void.webp", "charImg": null, "speaker": "???", "text": "at last…", "typeSpeed": 22, "music": "music/dark.mp3", "next": "prologue_19" },
  { "id": "prologue_19", "bg": "images/backgrounds/void.webp", "charImg": null, "speaker": "???", "text": "you belong to me?", "typeSpeed": 22, "music": "music/dark.mp3", "next": "prologue_20" },
  { "id": "prologue_20", "bg": "images/backgrounds/void.webp", "charImg": null, "speaker": null, "text": "I hold back a sob. I want to close my eyes. I want to wake up.", "typeSpeed": 22, "music": "music/dark.mp3", "bloodRealism": 18, "next": "prologue_21" },
  { "id": "prologue_21", "bg": "images/backgrounds/void.webp", "charImg": null, "speaker": null, "text": "My vision blurs.", "typeSpeed": 22, "music": "music/dark.mp3", "bloodRealism": 50, "next": "prologue_22" },
  { "id": "prologue_22", "bg": "images/backgrounds/void.webp", "charImg": null, "speaker": null, "text": "The edges of the world fade away one by one, swallowed by a strange scarlet glow.", "typeSpeed": 20, "music": "music/dark.mp3", "bloodRealism": 100, "finalRed": true, "next": "__suite_suivante__" }
]