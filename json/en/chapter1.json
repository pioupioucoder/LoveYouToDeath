    "bg": "images/backgrounds/school_hallway.webp",
    "charImg": "images/characters/plumtalkneutral.png",
    "speaker": "Plum",
    "text": "Could we be friends?",
    "typeSpeed": 22,
    "music": "music/day.mp3",
    "choices": [
      {
        "text": "Of course.",
        "next": "chapter1_37",
