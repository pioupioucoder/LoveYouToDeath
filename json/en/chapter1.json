    "music": "music/day.mp3",
    "next": "chapter1_11"
  },
  {
    "id": "chapter1_11",
    "bg": "images/backgrounds/school_hallway.webp",
    "charImg": null,
    "speaker": null,
    "text": "No signature.",
    "typeSpeed": 22,
    "music": "music/day.mp3",
    "next": "chapter1_12"
  },
  {
    "id": "chapter1_12",
    "bg": "images/backgrounds/school_hallway.webp",
    "charImg": null,
    "speaker": null,
    "text": "I read the few lines again, not really sure what to make of them.",
    "typeSpeed": 22,
    "music": "music/day.mp3",
    "choices": [
      {
        "text": "This is… beautiful. Whoever wrote this really touched me.",
        "next": "chapter1_13",
