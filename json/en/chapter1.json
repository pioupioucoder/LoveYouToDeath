  },
  {
    "id": "chapter1_3",
    "bg": null,
    "charImg": null,
    "speaker": null,
    "text": "As if someone were watching me.",
    "typeSpeed": 22,
    "music": "music/eyes.mp3",
    "eyesEffect": true,
    "next": "chapter1_4"
  },
  {
    "id": "chapter1_4",
    "bg": null,
    "charImg": null,
    "speaker": null,
    "text": "Even when I sleep, I can't seem to shake it.",
    "typeSpeed": 22,
    "music": "music/eyes.mp3",
    "eyesEffect": true,
    "next": "chapter1_5"
  },
  {
    "id": "chapter1_5",
    "bg": "images/backgrounds/school_hallway.webp",
    "charImg": null,
    "speaker": null,
    "text": "Sunlight streams through the large windows of the school, spilling across the hallway. ",
    "typeSpeed": 22,
    "music": "music/day.mp3",
    "next": "chapter1_6"
  },
  {
    "id": "chapter1_6",
    "bg": "images/backgrounds/school_hallway.webp",
    "charImg": null,
    "speaker": null,
    "text": "I walk quickly toward my locker, glancing around every now and then without really knowing why.",
    "typeSpeed": 22,
    "music": "music/day.mp3",
    "next": "chapter1_7"
  },
  {
    "id": "chapter1_7",
    "bg": "images/backgrounds/school_hallway.webp",
    "charImg": null,
    "speaker": null,
    "text": "I notice a piece of paper sticking out of my locker. I slow down.",
    "typeSpeed": 22,
    "music": "music/day.mp3",
    "next": "chapter1_8"
  },
  {
    "id": "chapter1_8",
    "bg": "images/backgrounds/school_hallway.webp",
    "charImg": null,
    "speaker": null,
    "text": "I don't remember leaving anything here.",
    "typeSpeed": 22,
    "music": "music/day.mp3",
    "next": "chapter1_9"
  },
  {
    "id": "chapter1_9",
    "bg": "images/backgrounds/school_hallway.webp",
    "charImg": null,
    "speaker": null,
    "text": "I gently pull the paper out.",
    "typeSpeed": 22,
    "music": "music/day.mp3",
    "next": "chapter1_10"
  },
  {
    "id": "chapter1_10",
    "bg": "images/backgrounds/school_hallway.webp",
